HF_TOKEN=

MODEL_NAME=distilbert-base-uncased

dataset_path=customer-support-intent-classification-dataset/versions/1/cleaned_data_for_training.csv
new_dataset_folder=new_data
test_size=0.2
random_state=42

num_train_epochs=1

per_device_train_batch_size=16
per_device_eval_batch_size=16

weight_decay=0.01

eval_strategy=epoch
save_strategy=epoch

load_best_model_at_end=True

logging_steps=10
learning_rate=1e-5
logging_strategy=epoch

metric_for_best_model=accuracy
greater_is_better=True

model_out_directory=./results
symlinkpath=current_model

metrics_output_file=training_metrics.json

label_mapping_file_path=customer-support-intent-classification-dataset/versions/1/label_mapping.json

accuracy_comparison_file=accuracy.json

unseen_data_path=external_evaluation_dataset.json
